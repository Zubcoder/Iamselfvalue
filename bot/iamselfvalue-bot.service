[Unit]
Description=Iamselfvalue Telegram Bot
After=network.target

[Service]
Type=simple
User=iamselfvalue
Group=iamselfvalue
WorkingDirectory=/opt/iamselfvalue/bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/iamselfvalue/bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
